# BigWigs packager layout. The addon sits in SmartBlessingBar/, beside the
# repository's README, LICENSE and tooling: the packager copies the checkout to
# .release/SmartBlessingBar/, moves the addon's files up into that folder and
# zips only it. Dotfiles are left out by the packager itself.
package-as: SmartBlessingBar

move-folders:
  SmartBlessingBar/SmartBlessingBar: SmartBlessingBar

ignore:
  - tests
