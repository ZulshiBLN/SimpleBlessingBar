# BigWigs packager layout. The addon sits in SimpleBlessingBar/, beside the
# repository's README, LICENSE and tooling: the packager copies the checkout to
# .release/SimpleBlessingBar/, moves the addon's files up into that folder and
# zips only it. Dotfiles are left out by the packager itself.
package-as: SimpleBlessingBar

move-folders:
  SimpleBlessingBar/SimpleBlessingBar: SimpleBlessingBar

ignore:
  - tests
